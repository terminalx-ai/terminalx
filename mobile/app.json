{
  "expo": {
    "name": "TerminalX",
    "slug": "terminalx-mobile",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "terminalx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.terminalx.next.mobile",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "TerminalX connects directly to a Mac you choose to pair."
      }
    },
    "android": {
      "package": "com.terminalx.next.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TerminalX to attach the photos you choose to a message for your agent."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow TerminalX to hear what you dictate to your agent.",
          "speechRecognitionPermission": "Allow TerminalX to turn what you dictate into a message for your agent."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TerminalX to scan a pairing code shown on your Mac."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
