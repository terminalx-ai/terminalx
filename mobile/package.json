{
  "name": "@terminalx/mobile",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "ios": "APP_VARIANT=development expo prebuild --platform ios --no-clean && APP_VARIANT=development expo run:ios",
    "ios:simulator": "python3 scripts/ios-simulator.py",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "interop": "tsx scripts/interop-relay.ts"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@terminalx/portable": "workspace:*",
    "@xterm/headless": "6.0.0",
    "buffer": "6.0.3",
    "entities": "8.0.0",
    "expo": "~58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-speech-recognition": "58.0.1",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "fflate": "0.8.3",
    "lucide-react-native": "1.40.0",
    "marked": "17.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
