  "devDependencies": {
    "@react-native/metro-config": "0.88.1",
    "@types/node": "^26.4.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
