+struct TXPathPin: Codable, Equatable {
+    let path: String
+    let device: UInt64
+    let inode: UInt64
+}
+final class TXDescriptor: @unchecked Sendable {
+    let raw: Int32
+    init(_ raw: Int32) throws { try txRequire(raw >= 0); self.raw = raw }
+    deinit { Darwin.close(raw) }
+}
