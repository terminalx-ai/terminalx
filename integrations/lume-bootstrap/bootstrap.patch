+        if launch.binding.version == 2 && ["accountReceipt", "keyReceipt"].contains(action) { throw TXBootstrapError.refused }
+        // Version 3 has no share trust path: only enrollment and an owner-mediated
+        // stop are served, and neither is served for earlier versions.
+        let enrolledOnly = ["enrollment", "stop", "accountObservation", "confirmAccount", "accountAnswer", "grantKey", "keyAnswer",
+            "hostKeyObservation"]
+        try txRequire(launch.binding.version == 3
+            ? (["observe"] + enrolledOnly).contains(action) : !enrolledOnly.contains(action))
+        switch action {
+        case "guestObservation": receipt = try launch.pins["operation"]!.receipt("guest-observation.json")
+        case "enrollment": receipt = try launch.pins["operation"]!.receipt("enrollment.json")
+        case "stop": (receipt, stopAfterReply) = try requestStop()
+        case "accountObservation": receipt = try launch.pins["operation"]!.receipt("account-observation.json")
+        case "confirmAccount":
+            receipt = try TXAccountRelay.record(requestPayload!, launch: launch)
+            state.lock(); let wake = onRelay; state.unlock()
+            wake?()
+        case "accountAnswer": receipt = try launch.pins["operation"]!.receipt("account-confirmation-answer.json")
+        case "grantKey":
+            receipt = try TXAccountRelay.recordGrant(requestPayload!, launch: launch)
+            state.lock(); let wake = onRelay; state.unlock()
+            wake?()
+        case "keyAnswer": receipt = try launch.pins["operation"]!.receipt("key-install-result.json")
+        case "hostKeyObservation": receipt = try launch.pins["operation"]!.receipt("host-key-observation.json")
+        case "accountReceipt": receipt = try launch.pins["output"]!.receipt("account-receipt.json")
+        case "keyReceipt": receipt = try launch.pins["output"]!.receipt("public-key-receipt.json")
+        default: receipt = Data()
+        }
+        try check()
+        let payload = try txJSON(["bindingDigest": launch.bindingDigest, "epoch": launch.binding.ownerEpoch,
+            "requestId": requestId, "action": action, "receipt": receipt.base64EncodedString(),
+            "receiptSha256": txDigest(receipt), "consoleAvailable": false, "ready": false])
+        try TXWire.write(fd, txJSON(["payload": payload.base64EncodedString(),
+                                    "mac": txTag(launch.capability, "receipt", parts + [txDigest(payload)])]))
+        // Journaled, then answered, then the VM is asked to stop.
+        stopAfterReply?()
+    }
+    /// Owner-mediated stop for a version-3 run: journals the request once, then
+    /// returns the stop to run after the reply is sent. A repeated request returns
+    /// the same record and never stops again. It never claims the VM or owner exited; the host's
+    /// original child-wait record is the exit evidence.
+    private func requestStop() throws -> (Data, (@Sendable () -> Void)?) {
+        let operation = launch.pins["operation"]!
+        if let existing = try? operation.receipt("stop-requested.json") { return (existing, nil) }
+        state.lock(); let stopper = stopper; state.unlock()
+        guard let stopper else { throw TXBootstrapError.refused }
+        try operation.writeNew("stop-requested.json", txJSON(["version": 1, "bindingDigest": launch.bindingDigest,
+            "ownerEpoch": launch.binding.ownerEpoch, "stopRequested": true, "exitConfirmed": false, "ready": false]))
+        return (try operation.receipt("stop-requested.json"), stopper)
+    }
+    fileprivate func setRelayNotifier(_ wake: @escaping @Sendable () -> Void) {
+        state.lock(); onRelay = wake; state.unlock()
+    }
+    fileprivate func setStopper(_ stop: @escaping @Sendable () -> Void) {
+        state.lock(); stopper = stop; state.unlock()
+    }
+    private func serve(maximum: Int?) {
+        var count = 0
+        let fixtureDeadline = DispatchTime.now().uptimeNanoseconds + 10_000_000_000
+        while maximum == nil || count < maximum! {
+            if maximum != nil && DispatchTime.now().uptimeNanoseconds > fixtureDeadline { break }
+            state.lock(); let closed = closed; state.unlock()
+            if closed { break }
+            var descriptor = pollfd(fd: listener, events: Int16(POLLIN), revents: 0)
+            if poll(&descriptor, 1, 100) <= 0 { continue }
+            let fd = accept(listener, nil, nil)
+            if fd < 0 { continue }
+            // Refusals never print request contents, capabilities or receipts.
+            do { try connection(fd) } catch { }
+            Darwin.close(fd)
+            count += 1
+        }
+    }
+    fileprivate static func start(launch: TerminalXBootstrapLaunch, view: TXOwnedVM, configLease: Int32) throws -> TerminalXBootstrapOwner {
+        let owner = try TerminalXBootstrapOwner(launch: launch, view: view, configLease: configLease)
+        DispatchQueue(label: "terminalx.bootstrap.owner").async { owner.serve(maximum: nil) }
+        return owner
+    }
+    #if TERMINALX_BOOTSTRAP_FIXTURES
+    static func fixture(launch: TerminalXBootstrapLaunch, view: TXOwnedVM, configLease: Int32, maximum: Int,
+                        enrollment: TXEnrollmentService? = nil) throws {
+        let owner = try TerminalXBootstrapOwner(launch: launch, view: view, configLease: configLease)
+        if let enrollment { owner.setRelayNotifier { enrollment.relayRecorded() } }
+        // The fixture's "VM" stops by ending the owner, as Lume's run returns.
+        owner.setStopper { [weak owner] in owner?.close() }
+        owner.serve(maximum: maximum)
+    }
+    #endif
+}
+
+#if !TERMINALX_BOOTSTRAP_FIXTURES
+import Virtualization
+
+extension TerminalXBootstrapOwner {
+    /// Runs in the actual VM-owning process. Neither RPC nor JSON can supply
+    /// this VZ object, its queue, the live shares or the retained config lease.
+    @MainActor
+    static func attach(launch: TerminalXBootstrapLaunch, service: DarwinVirtualizationService, configLease: Int32) throws -> TerminalXBootstrapOwner {
+        let handle = service.virtualMachineHandle
+        let view = TXOwnedVM {
+            try handle.queue.sync {
+                try txRequire(handle.machine.state == .running)
+                let devices = handle.machine.directorySharingDevices
+                try txRequire(devices.count == 1)
+                guard let fs = devices.first as? VZVirtioFileSystemDevice,
+                      fs.tag == VZVirtioFileSystemDeviceConfiguration.macOSGuestAutomountTag,
+                      let shares = fs.share as? VZMultipleDirectoryShare else { throw TXBootstrapError.refused }
+                try launch.validateMountedShares(shares.directories.map { ($0.key, $0.value.url.path, $0.value.isReadOnly) })
+            }
+        }
+        let owner = try start(launch: launch, view: view, configLease: configLease)
+        if launch.binding.version == 3 {
+            owner.setStopper { Task { @MainActor in try? await service.stop() } }
+        }
+        if launch.binding.version >= 2 {
+            let guestView = TXOwnedVM { [weak owner] in
+                guard let owner else { throw TXBootstrapError.refused }
+                try owner.check()
+            }
+            let listener = try TXGuestListener.install(launch: launch, view: guestView, service: service)
+            owner.guestListener = listener
+            if let enrollment = listener.enrollment { owner.setRelayNotifier { enrollment.relayRecorded() } }
+        }
+        return owner
+    }
+}
+#endif
