# Raccoon's whitespace, for editors that read this instead of asking.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[{LICENSE,THIRD-PARTY-NOTICES.md}]
# Licence text is reproduced verbatim; nothing here may reformat it.
trim_trailing_whitespace = false
insert_final_newline = false
