@@ -0,0 +1,44 @@
+import { renderToStaticMarkup } from 'react-dom/server'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { URL as NodeURL } from 'node:url'
+
+vi.mock('@openclaw/i18n', () => ({ t: (key: string) => key }))
+vi.mock('@/components', () => ({
+    GoDownloadButton: () => <button>Download</button>
+}))
+import JoinSession from '@/pages/JoinSession'
+
+afterEach(() => {
+    window.history.replaceState({}, '', '/')
+})
+describe('session invitation landing page', () => {
+    it('passes the secret only in the app-link fragment', () => {
+        window.history.replaceState({}, '', '/join#secret_fixture')
+        const html = renderToStaticMarkup(<JoinSession />)
+        expect(html).toContain('href="terminalx://join#secret_fixture"')
+        expect(html).toContain('Download')
+    })
+    it('offers no join for an absent or malformed fragment', () => {
+        window.history.replaceState({}, '', '/join#invalid?token=secret')
+        const html = renderToStaticMarkup(<JoinSession />)
+        expect(html).not.toContain('href=')
+        expect(html).toContain('sessionJoin.invalid')
+    })
+    it('does not install analytics on a page containing a bearer invitation', () => {
+        window.history.replaceState({}, '', '/join#secret_fixture')
+        const html = readFileSync(
+            new NodeURL('../../index.html', import.meta.url),
+            'utf8'
+        )
+        const script = html.match(/<script>([\s\S]*?)<\/script>/)?.[1]
+        expect(script).toBeTruthy()
+        const createElement = vi.spyOn(document, 'createElement')
+        const listen = vi.spyOn(window, 'addEventListener')
+        new Function('window', 'document', script)(window, document)
+        expect(createElement).not.toHaveBeenCalled()
+        expect(listen).not.toHaveBeenCalled()
+        createElement.mockRestore()
+        listen.mockRestore()
+    })
+})
