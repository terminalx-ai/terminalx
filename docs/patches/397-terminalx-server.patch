diff --git a/apps/web/src/pages/JoinSession.tsx b/apps/web/src/pages/JoinSession.tsx
new file mode 100644
index 00000000..83071aa0
--- /dev/null
+++ b/apps/web/src/pages/JoinSession.tsx
@@ -0,0 +1,46 @@
+import type { FC, ReactNode } from 'react'
+
+import { t } from '@openclaw/i18n'
+import { GoDownloadButton } from '@/components'
+
+const JOIN_SCHEME = 'terminalx://join' as const
+const SECRET_LIMIT = 16384 as const
+
+const JoinSession: FC = (): ReactNode => {
+    const secret = window.location.hash
+    const valid =
+        secret.length > 1 &&
+        secret.length < SECRET_LIMIT &&
+        /^#[A-Za-z0-9_-]+$/.test(secret)
+
+    return (
+        <main className='bg-background text-foreground flex min-h-screen items-center justify-center p-8'>
+            <div className='max-w-md space-y-6 text-center'>
+                <h1 className='text-2xl font-semibold'>
+                    {t('sessionJoin.title')}
+                </h1>
+                <p className='text-muted-foreground'>
+                    {t(
+                        valid
+                            ? 'sessionJoin.description'
+                            : 'sessionJoin.invalid'
+                    )}
+                </p>
+                {valid && (
+                    <a
+                        className='bg-primary text-primary-foreground inline-flex rounded-lg px-5 py-3'
+                        href={`${JOIN_SCHEME}${secret}`}
+                    >
+                        {t('sessionJoin.open')}
+                    </a>
+                )}
+                <div>
+                    <p className='mb-3'>{t('sessionJoin.install')}</p>
+                    <GoDownloadButton />
+                </div>
+            </div>
+        </main>
+    )
+}
+
+export default JoinSession
