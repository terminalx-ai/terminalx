+import type { FC, ReactNode } from 'react'
+
+import { t } from '@openclaw/i18n'
+import { Button } from '@/components/ui'
+import localSessionJoin from '@/lib/localSessionJoin'
+
+const JoinSession: FC = (): ReactNode => {
+    const secret = window.location.hash
+    const valid =
+        secret.length > 1 &&
+        secret.length < localSessionJoin.secretLimit &&
+        /^#[A-Za-z0-9_-]+$/.test(secret)
+
+    return (
+        <main className='flex min-h-screen items-center justify-center p-8'>
+            <div className='max-w-md space-y-6 text-center'>
+                <h1 className='text-2xl font-semibold'>
+                    {t('sessionJoin.title')}
+                </h1>
+                <p className='text-muted-foreground'>
+                    {t(
+                        valid
+                            ? 'sessionJoin.description'
+                            : 'sessionJoin.invalid'
+                    )}
+                </p>
+                {valid && (
+                    <Button size='lg' asChild>
+                        <a href={`${localSessionJoin.scheme}${secret}`}>
+                            {t('sessionJoin.open')}
+                        </a>
+                    </Button>
+                )}
+                <div>
+                    <p className='mb-3'>{t('sessionJoin.install')}</p>
+                    <a
+                        className='font-medium underline'
+                        href={localSessionJoin.downloadUrl}
+                        rel='noreferrer'
+                    >
+                        {t('console.launchDownload')}
+                    </a>
+                </div>
+            </div>
+        </main>
+    )
+}
+
+export default JoinSession
