new file mode 100644
index 00000000..c6a8d768
--- /dev/null
+++ b/apps/relay/src/conformance/session-invites.test.ts
@@ -0,0 +1,80 @@
+import { afterAll, describe, expect, test } from 'bun:test'
+import { randomUUID } from 'node:crypto'
+import { connectRelayRedis } from '@/registry/redis-store'
+import { DeviceCredentialStore } from '@/registry/device-credential-store'
+
+const redis = connectRelayRedis(
+    process.env.RELAY_TEST_REDIS_URL ?? 'redis://127.0.0.1:56379',
+    `share-test-${randomUUID()}`
+)
+const credentials = new DeviceCredentialStore(redis)
+afterAll(() => redis.close())
+
+describe('session invitations', () => {
+    test('allows several opaque relay connections until the host revokes the invitation', async () => {
+        const now = Date.now()
+        const invite = await credentials.mintInvite(
+            'host',
+            'session-link',
+            now,
+            { expiresAt: now + 60_000 }
+        )
+        expect(
+            await credentials.redeemInvite(
+                'other-host',
+                invite.inviteToken,
+                now
+            )
+        ).toBeNull()
+        expect(
+            await credentials.redeemInvite('host', invite.inviteToken, now)
+        ).toMatchObject({ relayDeviceId: 'session-link', reusable: true })
+        expect(
+            await credentials.redeemInvite('host', invite.inviteToken, now + 1)
+        ).not.toBeNull()
+        await credentials.revoke('host', 'session-link', 'revoke')
+        expect(
+            await credentials.redeemInvite('host', invite.inviteToken, now + 2)
+        ).toBeNull()
+    })
+    test('expires and replaces invitations without permitting the old secret to revive', async () => {
+        const now = Date.now()
+        const old = await credentials.mintInvite('host', 'replacement', now, {
+            expiresAt: now + 60_000
+        })
+        const next = await credentials.mintInvite('host', 'replacement', now, {
+            expiresAt: now + 120_000
+        })
+        expect(
+            await credentials.redeemInvite('host', old.inviteToken, now + 1)
+        ).toBeNull()
+        expect(
+            await credentials.redeemInvite('host', next.inviteToken, now + 1)
+        ).not.toBeNull()
+        expect(
+            await credentials.redeemInvite(
+                'host',
+                next.inviteToken,
+                now + 120_000
+            )
+        ).toBeNull()
+    })
+    test('preserves single-use phone pairing invitations', async () => {
+        const now = Date.now()
+        const invite = await credentials.mintInvite('host', 'phone', now)
+        expect(
+            await credentials.redeemInvite('host', invite.inviteToken, now)
+        ).not.toBeNull()
+        expect(
+            await credentials.redeemInvite('host', invite.inviteToken, now)
+        ).toBeNull()
+    })
+    test('refuses unbounded or already expired lifetimes', async () => {
+        const now = Date.now()
+        for (const expiresAt of [now, now - 1, now + 86_400_001]) {
+            await expect(
+                credentials.mintInvite('host', 'invalid', now, { expiresAt })
+            ).rejects.toThrow('invalid_share_invite_expiry')
+        }
+    })
+})
