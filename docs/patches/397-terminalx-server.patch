@@ -0,0 +1,99 @@
+import { Hono } from 'hono'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+const mocks = vi.hoisted(() => ({
+    resolveDesktop: vi.fn(),
+    resolveMobile: vi.fn(),
+    session: vi.fn(),
+    getUser: vi.fn()
+}))
+
+vi.mock('@/services/desktopTokens', () => ({
+    resolveAccessToken: mocks.resolveDesktop,
+    issueDesktopSession: vi.fn(),
+    revokeDesktopSession: vi.fn(),
+    rotateRefreshToken: vi.fn()
+}))
+vi.mock('@/services/cloudTokens', () => ({
+    default: { resolveAccess: mocks.resolveMobile }
+}))
+vi.mock('@/services/firebase', () => ({
+    auth: () => ({ getUser: mocks.getUser })
+}))
+vi.mock('@/controllers/desktop/buildDesktopSession', () => ({
+    buildDesktopSessionBody: mocks.session,
+    buildMobileCapabilitySessionBody: mocks.session
+}))
+
+const { default: authenticate } =
+    await import('@/middleware/desktopOrMobileAuth')
+const { desktopAuthCapabilities } = await import('@/controllers/desktop/auth')
+const app = new Hono()
+app.post('/capabilities', authenticate, desktopAuthCapabilities)
+const request = (token = 'valid-account') =>
+    app.request('/capabilities', {
+        method: 'POST',
+        headers: { Authorization: `Bearer ${token}` }
+    })
+
+beforeEach(() => {
+    vi.resetAllMocks()
+    mocks.resolveDesktop.mockImplementation(async (token: string) =>
+        token === 'valid-account'
+            ? { userId: 'guest', cloudProfileId: 'profile' }
+            : null
+    )
+    mocks.resolveMobile.mockResolvedValue(null)
+    mocks.session.mockResolvedValue({
+        cloud: {
+            userId: 'guest',
+            email: 'Guest@example.com',
+            displayName: 'Guest'
+        },
+        organizations: []
+    })
+    mocks.getUser.mockResolvedValue({
+        email: 'guest@example.com',
+        emailVerified: true
+    })
+})
+
+describe('signed-in session guest identity', () => {
+    it('returns stable identity and verified email without organization membership', async () => {
+        const response = await request()
+        expect(response.status).toBe(200)
+        const body = await response.json()
+        expect(body.cloud).toEqual({
+            userId: 'guest',
+            email: 'Guest@example.com',
+            displayName: 'Guest',
+            emailVerified: true
+        })
+        expect(body.organizations).toEqual([])
+        expect(mocks.getUser).toHaveBeenCalledWith('guest')
+    })
+    it.each([
+        { email: 'other@example.com', emailVerified: true },
+        { email: 'guest@example.com', emailVerified: false }
+    ])(
+        'fails closed for a mismatched or unverified Firebase email',
+        async (identity) => {
+            mocks.getUser.mockResolvedValue(identity)
+            expect((await (await request()).json()).cloud.emailVerified).toBe(
+                false
+            )
+        }
+    )
+    it('does not assert email verification if Firebase is unavailable', async () => {
+        mocks.getUser.mockRejectedValue(new Error('unavailable'))
+        expect((await (await request()).json()).cloud.emailVerified).toBe(false)
+    })
+    it('refuses anonymous and invalid credentials before reading identity', async () => {
+        expect(
+            (await app.request('/capabilities', { method: 'POST' })).status
+        ).toBe(401)
+        expect((await request('invalid-account')).status).toBe(401)
+        expect(mocks.session).not.toHaveBeenCalled()
+        expect(mocks.getUser).not.toHaveBeenCalled()
+    })
+})
