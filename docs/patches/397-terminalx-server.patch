+import { renderToStaticMarkup } from 'react-dom/server'
+import { StaticRouter } from 'react-router-dom/server'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { setLanguage } from '@openclaw/i18n'
+import App from '@/App'
+import JoinSession from '@/pages/JoinSession'
+
+vi.mock('@/lib/AuthProvider', () => ({
+    useAuth: () => ({ user: null, loading: true })
+}))
+vi.mock('@/lib/useTheme', () => ({
+    default: () => ({ theme: 'dark', toggle: vi.fn() })
+}))
+vi.mock('@/lib/language', () => ({
+    useLanguage: () => ({ language: 'en', supported: ['en'], change: vi.fn() })
+}))
+
+beforeEach(() => setLanguage('en'))
+afterEach(() => window.history.replaceState({}, '', '/'))
+
+describe('public session invitation', () => {
+    it('opens the app with the invitation only in its fragment', () => {
+        window.history.replaceState({}, '', '/join#secret_fixture')
+        const html = renderToStaticMarkup(<JoinSession />)
+        expect(html).toContain('href="terminalx://join#secret_fixture"')
+        expect(html).toContain('href="https://terminalx.ai/go"')
+    })
+
+    it.each(['', '#invalid?token=secret'])(
+        'refuses malformed fragment %s',
+        (fragment) => {
+            window.history.replaceState({}, '', `/join${fragment}`)
+            const html = renderToStaticMarkup(<JoinSession />)
+            expect(html).not.toContain('href="terminalx://join')
+        }
+    )
+
+    it('shows the invitation before browser sign-in has completed', () => {
+        window.history.replaceState({}, '', '/join#secret_fixture')
+        const html = renderToStaticMarkup(
+            <StaticRouter location='/join#secret_fixture'>
+                <App />
+            </StaticRouter>
+        )
+        expect(html).toContain('href="terminalx://join#secret_fixture"')
+    })
+})
