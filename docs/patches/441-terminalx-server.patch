+import { sql } from 'drizzle-orm'
+import {
+    boolean,
+    check,
+    index,
+    pgTable,
+    text,
+    timestamp,
+    uniqueIndex
+} from 'drizzle-orm/pg-core'
+import users from '@/db/schema/users'
+
+// terminalx#441: one session, on one device of one person, linked to a
+// tracker issue. The desktop replaces its whole set per device; nothing here
+// is a prompt, a transcript, a path or code.
+const issueWorkClaims = pgTable(
+    'issue_work_claims',
+    {
+        id: text('id').primaryKey(),
+        userId: text('user_id')
+            .notNull()
+            .references(() => users.id, { onDelete: 'cascade' }),
+        deviceId: text('device_id').notNull(),
+        deviceLabel: text('device_label').notNull(),
+        sessionId: text('session_id').notNull(),
+        scope: text('scope').notNull(),
+        // The project's normalised remote; null when it has none. Decides
+        // whether teammates may see the claim.
+        repository: text('repository'),
+        issueProvider: text('issue_provider').notNull(),
+        issueId: text('issue_id').notNull(),
+        issueIdentifier: text('issue_identifier').notNull(),
+        title: text('title').notNull(),
+        branch: text('branch'),
+        state: text('state').notNull(),
+        cloud: boolean('cloud').notNull().default(false),
+        shareWithTeam: boolean('share_with_team').notNull().default(false),
+        since: timestamp('since', { withTimezone: true }).notNull(),
+        lastActiveAt: timestamp('last_active_at', {
+            withTimezone: true
+        }).notNull(),
+        refreshedAt: timestamp('refreshed_at', {
+            withTimezone: true
+        }).notNull(),
+        expiresAt: timestamp('expires_at', { withTimezone: true }).notNull(),
+        createdAt: timestamp('created_at', { withTimezone: true })
+            .defaultNow()
+            .notNull(),
+        updatedAt: timestamp('updated_at', { withTimezone: true })
+            .defaultNow()
+            .notNull()
+    },
+    (table) => [
+        check(
+            'issue_work_claims_state_check',
+            sql`${table.state} IN ('working', 'waiting', 'idle', 'pull_request')`
+        ),
+        check(
+            'issue_work_claims_provider_check',
+            sql`${table.issueProvider} IN ('github', 'linear')`
+        ),
+        uniqueIndex('issue_work_claims_session_idx').on(
+            table.userId,
+            table.deviceId,
+            table.sessionId
+        ),
+        index('issue_work_claims_scope_idx').on(
+            table.scope,
+            table.issueProvider
+        ),
+        index('issue_work_claims_user_idx').on(table.userId),
+        index('issue_work_claims_expires_idx').on(table.expiresAt)
+    ]
+)
+
