+import { describe, expect, it } from 'vitest'
+import WorkClaimsError from '@/services/workClaims/WorkClaimsError'
+import workClaimsValidation from '@/services/workClaims/validation'
+
+const githubClaim = (overrides: Record<string, unknown> = {}) => ({
+    sessionId: '8c1e4f2a-session',
+    scope: 'github.com/acme/widgets',
+    repository: 'github.com/acme/widgets',
+    issue: { provider: 'github', id: '441', identifier: '#441' },
+    title: '#441 Show who is working on an issue',
+    branch: 'raccoon/441-show-who-is-working',
+    state: 'working',
+    cloud: false,
+    shareWithTeam: true,
+    idleSeconds: 42,
+    ...overrides
+})
+
+const linearClaim = (overrides: Record<string, unknown> = {}) => ({
+    ...githubClaim(),
+    sessionId: 'linear-session',
+    scope: 'linear.app/acme',
+    issue: {
+        provider: 'linear',
+        id: '3f1c9b2e-7a4d-4c1e-9f2a-1b2c3d4e5f60',
+        identifier: 'ENG-42'
+    },
+    ...overrides
+})
+
+const body = (claims: unknown[], extra: Record<string, unknown> = {}) => ({
+    deviceLabel: 'Studio Mac',
+    claims,
+    ...extra
+})
+
+const refused = (run: () => unknown) => {
+    try {
+        run()
+    } catch (error) {
+        expect(error).toBeInstanceOf(WorkClaimsError)
+        expect((error as WorkClaimsError).message).toBe(
+            'work_claims_invalid_request'
+        )
+        expect((error as WorkClaimsError).status).toBe(400)
+        return
+    }
+    throw new Error('accepted')
