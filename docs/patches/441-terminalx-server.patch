+import { workClaims } from '@/lib/constants'
+import { AccountPairingError } from '@/services/accountPairing'
+import checkAccountPairingRateLimit from '@/services/accountPairing/rateLimit'
+import WorkClaimsError from '@/services/workClaims/WorkClaimsError'
+
+const { publishRateLimit } = workClaims
+
+/**
+ * One publish per (person, device) every two seconds, on the same
+ * `rate_limits` lanes as the Host binding heartbeat (subjects stored hashed).
+ */
+const limitDevicePublish = async (
+    userId: string,
+    deviceId: string,
+    now: Date = new Date()
+): Promise<void> => {
+    try {
+        await checkAccountPairingRateLimit({
+            operation: publishRateLimit.operation,
+            subjects: [`${userId}\n${deviceId}`],
+            maxRequests: publishRateLimit.maxRequests,
+            windowMs: publishRateLimit.windowMs,
+            now
+        })
+    } catch (error) {
+        if (error instanceof AccountPairingError && error.status === 429)
+            throw new WorkClaimsError(
+                workClaims.errors.rateLimited,
+                429,
+                error.retryAfterSeconds
+            )
+        throw error
+    }
+}
+
+export default limitDevicePublish
