+    WorkClaimIssue,
+    WorkClaimProvider,
+    WorkClaimState
+} from '@/ts/Types'
+
+import { workClaims } from '@/lib/constants'
+import WorkClaimsError from '@/services/workClaims/WorkClaimsError'
+
+const DEVICE_ID = /^[A-Za-z0-9_-]{8,64}$/
+const SESSION_ID = /^[A-Za-z0-9_.:/-]{1,160}$/
+const ISSUE_ID = /^[A-Za-z0-9_-]{1,128}$/
+const SCOPE: Record<WorkClaimProvider, RegExp> = {
+    github: /^github\.com\/[a-z0-9-]{1,39}\/[a-z0-9._-]{1,100}$/,
+    linear: /^linear\.app\/[a-z0-9-]{1,64}$/
+}
+const IDENTIFIER: Record<WorkClaimProvider, RegExp> = {
+    github: /^#[0-9]{1,10}$/,
+    linear: /^[A-Z][A-Z0-9_]{0,9}-[0-9]{1,10}$/
+}
+const REPOSITORY =
+    /^[a-z0-9.-]{1,253}(:[0-9]{1,5})?(\/[a-z0-9._~-]{1,100}){1,8}$/
+const BRANCH = /^[^\s\p{Cc}]{1,255}$/u
+const CONTROL_CHARACTER = /\p{Cc}/u
+const PROVIDERS: readonly string[] = Object.values(workClaims.providers)
+const STATES: readonly string[] = Object.values(workClaims.states)
+const CLAIM_KEYS = [
+    'sessionId',
+    'scope',
+    'issue',
+    'title',
+    'state',
+    'cloud',
+    'shareWithTeam',
+    'idleSeconds'
+] as const
+const NULLABLE_CLAIM_KEYS = ['repository', 'branch'] as const
+
+const invalid = (): never => {
+    throw new WorkClaimsError(workClaims.errors.invalidRequest, 400)
+}
+
+const record = (value: unknown): Record<string, unknown> => {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) invalid()
+    return value as Record<string, unknown>
+}
+
+const onlyKeys = (
+    value: Record<string, unknown>,
+    required: readonly string[],
+    optional: readonly string[] = []
+): void => {
+    if (
+        required.some((key) => !Object.hasOwn(value, key)) ||
+        Object.keys(value).some(
+            (key) => !required.includes(key) && !optional.includes(key)
+        )
+    )
+        invalid()
+}
+
+const text = (value: unknown, maximum: number): string => {
+    if (typeof value !== 'string') invalid()
+    const trimmed = (value as string).trim()
+    const length = [...trimmed].length
+    if (length < 1 || length > maximum || CONTROL_CHARACTER.test(trimmed))
+        invalid()
+    return trimmed
+}
+
+const matching = (value: unknown, pattern: RegExp): string => {
+    if (typeof value !== 'string' || !pattern.test(value)) invalid()
+    return value as string
+}
+
+const lowerMatching = (value: unknown, pattern: RegExp): string => {
+    if (typeof value !== 'string') invalid()
+    return matching((value as string).toLowerCase(), pattern)
+}
+
+const provider = (value: unknown): WorkClaimProvider => {
+    if (typeof value !== 'string' || !PROVIDERS.includes(value)) invalid()
+    return value as WorkClaimProvider
+}
+
+const boolean = (value: unknown): boolean => {
+    if (typeof value !== 'boolean') invalid()
+    return value as boolean
+}
+
+const deviceId = (value: unknown): string => matching(value, DEVICE_ID)
+
+const scope = (value: unknown, issueProvider: WorkClaimProvider): string =>
+    lowerMatching(value, SCOPE[issueProvider])
+
+const repository = (value: unknown): string | null => {
+    if (value === null || value === undefined) return null
+    const parsed = lowerMatching(value, REPOSITORY)
+    if (parsed.length > workClaims.limits.repositoryChars) invalid()
+    return parsed
+}
+
+const branch = (value: unknown): string | null => {
+    if (value === null || value === undefined) return null
+    return matching(value, BRANCH)
+}
+
+const issue = (value: unknown): WorkClaimIssue => {
+    const body = record(value)
+    onlyKeys(body, ['provider', 'id', 'identifier'])
+    const issueProvider = provider(body.provider)
+    if (typeof body.identifier !== 'string') invalid()
+    return {
+        provider: issueProvider,
+        id: matching(body.id, ISSUE_ID),
+        identifier: matching(
+            issueProvider === workClaims.providers.linear
+                ? (body.identifier as string).toUpperCase()
+                : body.identifier,
+            IDENTIFIER[issueProvider]
+        )
+    }
+}
+
+const state = (value: unknown): WorkClaimState => {
+    if (typeof value !== 'string' || !STATES.includes(value)) invalid()
+    return value as WorkClaimState
+}
+
+const idleSeconds = (value: unknown): number => {
+    if (
+        !Number.isSafeInteger(value) ||
+        (value as number) < 0 ||
+        (value as number) > workClaims.maxIdleSeconds
+    )
+        invalid()
+    return value as number
+}
+
+const claim = (value: unknown): WorkClaimInput => {
+    const body = record(value)
+    onlyKeys(body, CLAIM_KEYS, NULLABLE_CLAIM_KEYS)
+    const parsedIssue = issue(body.issue)
+    return {
+        sessionId: matching(body.sessionId, SESSION_ID),
+        scope: scope(body.scope, parsedIssue.provider),
+        repository: repository(body.repository),
+        issue: parsedIssue,
+        title: text(body.title, workClaims.limits.titleChars),
+        branch: branch(body.branch),
+        state: state(body.state),
+        cloud: boolean(body.cloud),
+        shareWithTeam: boolean(body.shareWithTeam),
+        idleSeconds: idleSeconds(body.idleSeconds)
+    }
+}
+
+/**
+ * A device's whole claim set. Strict: an unknown key anywhere (a prompt, a
+ * transcript, a path) fails the request instead of being dropped, so a
+ * field added by mistake on the desktop is caught at once.
+ */
+const parseReplace = (value: unknown): WorkClaimsReplaceInput => {
+    const body = record(value)
+    onlyKeys(body, ['deviceLabel', 'claims'])
+    if (
+        !Array.isArray(body.claims) ||
+        body.claims.length > workClaims.maxClaimsPerDevice
+    )
+        invalid()
+    const claims = (body.claims as unknown[]).map(claim)
+    if (new Set(claims.map((entry) => entry.sessionId)).size !== claims.length)
+        invalid()
+    return {
+        deviceLabel: text(body.deviceLabel, workClaims.limits.deviceLabelChars),
+        claims
+    }
+}
+
+const parseListQuery = (
+    queries: Record<string, string[]>
+): WorkClaimsListQuery => {
+    const providers = queries.provider ?? []
+    const scopes = queries.scope ?? []
+    if (
+        providers.length !== 1 ||
+        scopes.length < 1 ||
+        scopes.length > workClaims.maxScopesPerRead
+    )
+        invalid()
+    const issueProvider = provider(providers[0])
+    return {
+        provider: issueProvider,
+        scopes: [...new Set(scopes.map((entry) => scope(entry, issueProvider)))]
+    }
+}
+
+const parseWorkStatusUpdate = (value: unknown): WorkStatusUpdateInput => {
+    const body = record(value)
+    onlyKeys(body, ['shareWorkStatus'])
+    return { shareWorkStatus: boolean(body.shareWorkStatus) }
+}
+
+const workClaimsValidation = {
+    deviceId,
+    parseReplace,
+    parseListQuery,
+    parseWorkStatusUpdate
+}
+
+export default workClaimsValidation
