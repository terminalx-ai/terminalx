--- /dev/null
+++ b/apps/api/src/services/workClaims/workStatusSettings.ts
@@ -0,0 +1,94 @@
+import type { WorkStatusViewer } from '@/ts/Interfaces'
+import type { WorkStatusSettingsView } from '@/ts/Types'
+
+import { and, eq, sql } from 'drizzle-orm'
+import { orgRole } from '@openclaw/shared'
+import { db } from '@/db'
+import {
+    memberships,
+    organizations,
+    organizationWorkStatusSettings
+} from '@/db/schema'
+import { workClaims } from '@/lib/constants'
+import WorkClaimsError from '@/services/workClaims/WorkClaimsError'
+import workClaimsValidation from '@/services/workClaims/validation'
+
+const MANAGE_ROLES: readonly string[] = [orgRole.owner, orgRole.admin]
+
+/**
+ * Membership doubles as visibility, as in the member routes: a non-member
+ * gets 404, so an organization's existence cannot be probed.
+ */
+const viewerFor = async (
+    userId: string,
+    organizationId: string
+): Promise<WorkStatusViewer> => {
+    const [viewer] = await db
+        .select({
+            role: memberships.role,
+            isPersonal: organizations.isPersonal,
+            shareWorkStatus: sql<boolean>`coalesce(${organizationWorkStatusSettings.shareWorkStatus}, true)`
+        })
+        .from(memberships)
+        .innerJoin(
+            organizations,
+            eq(organizations.id, memberships.organizationId)
+        )
+        .leftJoin(
+            organizationWorkStatusSettings,
+            eq(organizationWorkStatusSettings.organizationId, organizations.id)
+        )
+        .where(
+            and(
+                eq(memberships.userId, userId),
+                eq(memberships.organizationId, organizationId)
+            )
+        )
+        .limit(1)
+    if (!viewer) throw new WorkClaimsError(workClaims.errors.notFound, 404)
+    return { userId, organizationId, ...viewer }
+}
+
+/** A personal organization never shares, so it has no switch to offer. */
+const viewOf = (viewer: WorkStatusViewer): WorkStatusSettingsView => ({
+    shareWorkStatus: !viewer.isPersonal && viewer.shareWorkStatus,
+    canManage: !viewer.isPersonal && MANAGE_ROLES.includes(viewer.role),
+    personal: viewer.isPersonal
+})
+
+const get = async (
+    userId: string,
+    organizationId: string
+): Promise<WorkStatusSettingsView> =>
+    viewOf(await viewerFor(userId, organizationId))
+
+const update = async (
+    userId: string,
+    organizationId: string,
+    body: unknown,
+    now: Date = new Date()
+): Promise<WorkStatusSettingsView> => {
+    const viewer = await viewerFor(userId, organizationId)
+    if (!MANAGE_ROLES.includes(viewer.role))
+        throw new WorkClaimsError(workClaims.errors.forbidden, 403)
+    if (viewer.isPersonal)
+        throw new WorkClaimsError(workClaims.errors.personalOrganization, 400)
+    const { shareWorkStatus } = workClaimsValidation.parseWorkStatusUpdate(body)
+    await db
+        .insert(organizationWorkStatusSettings)
+        .values({
+            organizationId,
+            shareWorkStatus,
+            updatedBy: userId,
+            updatedAt: now
+        })
+        .onConflictDoUpdate({
+            target: organizationWorkStatusSettings.organizationId,
+            set: { shareWorkStatus, updatedBy: userId, updatedAt: now }
+        })
+    return viewOf({ ...viewer, shareWorkStatus })
+}
+
+const workStatusSettings = { get, update }
+
+export default workStatusSettings
