+import type { Context } from 'hono'
+
+import { desktopError, desktopJson } from '@/lib/desktopResponse'
+import { workClaims } from '@/lib/constants'
+import {
+    WorkClaimsError,
+    listVisibleClaims,
+    replaceDeviceClaims,
+    withdrawDeviceClaims,
+    workClaimsValidation,
+    workStatusSettings
+} from '@/services/workClaims'
+
+const userIdOf = (c: Context): string => c.get('desktopUserId') as string
+
+const bodyOf = (c: Context): Promise<unknown> => c.req.json().catch(() => null)
+
+const respond = async (
+    c: Context,
+    operation: () => Promise<Record<string, unknown>>
+) => {
+    try {
+        return desktopJson(c, await operation())
+    } catch (error) {
+        if (error instanceof WorkClaimsError)
+            return desktopError(c, error.message, error.status)
+        console.error('workClaimsResponse', error)
+        return desktopError(c, workClaims.errors.internal, 500)
+    }
+}
+
+const replace = (c: Context) =>
+    respond(c, async () => {
+        const deviceId = workClaimsValidation.deviceId(c.req.param('deviceId'))
+        const input = workClaimsValidation.parseReplace(await bodyOf(c))
+        return replaceDeviceClaims(userIdOf(c), deviceId, input)
+    })
+
+const withdraw = (c: Context) =>
+    respond(c, async () => {
+        const deviceId = workClaimsValidation.deviceId(c.req.param('deviceId'))
+        await withdrawDeviceClaims(userIdOf(c), deviceId)
+        return { claims: 0 }
+    })
+
+const list = (c: Context) =>
+    respond(c, () =>
+        listVisibleClaims(
+            userIdOf(c),
+            workClaimsValidation.parseListQuery(c.req.queries())
+        )
+    )
+
+const workStatus = (c: Context) =>
+    respond(c, () =>
+        workStatusSettings.get(userIdOf(c), c.req.param('orgId') ?? '')
+    )
+
+const updateWorkStatus = (c: Context) =>
+    respond(c, async () =>
+        workStatusSettings.update(
+            userIdOf(c),
+            c.req.param('orgId') ?? '',
+            await bodyOf(c)
+        )
+    )
+
+const workClaimsController = {
+    replace,
+    withdraw,
+    list,
+    workStatus,
+    updateWorkStatus
+}
+
+export default workClaimsController
