+-- terminalx#441: who is working on an issue, across a person's machines and
+-- their teammates. Two new tables; nothing existing is rewritten or
+-- backfilled. A missing work status row means sharing is on.
+CREATE TABLE "issue_work_claims" (
+	"id" text PRIMARY KEY NOT NULL,
+	"user_id" text NOT NULL,
+	"device_id" text NOT NULL,
+	"device_label" text NOT NULL,
+	"session_id" text NOT NULL,
+	"scope" text NOT NULL,
+	"repository" text,
+	"issue_provider" text NOT NULL,
+	"issue_id" text NOT NULL,
+	"issue_identifier" text NOT NULL,
+	"title" text NOT NULL,
+	"branch" text,
+	"state" text NOT NULL,
+	"cloud" boolean DEFAULT false NOT NULL,
+	"share_with_team" boolean DEFAULT false NOT NULL,
+	"since" timestamp with time zone NOT NULL,
+	"last_active_at" timestamp with time zone NOT NULL,
+	"refreshed_at" timestamp with time zone NOT NULL,
+	"expires_at" timestamp with time zone NOT NULL,
+	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
+	"updated_at" timestamp with time zone DEFAULT now() NOT NULL,
+	CONSTRAINT "issue_work_claims_state_check" CHECK ("issue_work_claims"."state" IN ('working', 'waiting', 'idle', 'pull_request')),
+	CONSTRAINT "issue_work_claims_provider_check" CHECK ("issue_work_claims"."issue_provider" IN ('github', 'linear'))
+);
+--> statement-breakpoint
+CREATE TABLE "organization_work_status_settings" (
+	"organization_id" text PRIMARY KEY NOT NULL,
+	"share_work_status" boolean DEFAULT true NOT NULL,
+	"updated_by" text,
+	"updated_at" timestamp with time zone DEFAULT now() NOT NULL
+);
+--> statement-breakpoint
+ALTER TABLE "issue_work_claims" ADD CONSTRAINT "issue_work_claims_user_id_users_id_fk" FOREIGN KEY ("user_id") REFERENCES "public"."users"("id") ON DELETE cascade ON UPDATE no action;--> statement-breakpoint
+ALTER TABLE "organization_work_status_settings" ADD CONSTRAINT "organization_work_status_settings_organization_id_organizations_id_fk" FOREIGN KEY ("organization_id") REFERENCES "public"."organizations"("id") ON DELETE cascade ON UPDATE no action;--> statement-breakpoint
+ALTER TABLE "organization_work_status_settings" ADD CONSTRAINT "organization_work_status_settings_updated_by_users_id_fk" FOREIGN KEY ("updated_by") REFERENCES "public"."users"("id") ON DELETE set null ON UPDATE no action;--> statement-breakpoint
+CREATE UNIQUE INDEX "issue_work_claims_session_idx" ON "issue_work_claims" USING btree ("user_id","device_id","session_id");--> statement-breakpoint
+CREATE INDEX "issue_work_claims_scope_idx" ON "issue_work_claims" USING btree ("scope","issue_provider");--> statement-breakpoint
+CREATE INDEX "issue_work_claims_user_idx" ON "issue_work_claims" USING btree ("user_id");--> statement-breakpoint
+CREATE INDEX "issue_work_claims_expires_idx" ON "issue_work_claims" USING btree ("expires_at");
