+    listVisibleClaims: vi.fn(),
+    getWorkStatus: vi.fn(),
+    updateWorkStatus: vi.fn()
+}))
+
+vi.mock('@/services/desktopTokens', async (importOriginal) => ({
+    ...(await importOriginal<Record<string, unknown>>()),
+    resolveAccessToken: mocks.resolveDesktop
+}))
+
+// The real validation and error type; only the database work is replaced.
+vi.mock('@/services/workClaims', async (importOriginal) => ({
+    ...(await importOriginal<Record<string, unknown>>()),
+    replaceDeviceClaims: mocks.replaceDeviceClaims,
+    withdrawDeviceClaims: mocks.withdrawDeviceClaims,
+    listVisibleClaims: mocks.listVisibleClaims,
+    workStatusSettings: {
+        get: mocks.getWorkStatus,
+        update: mocks.updateWorkStatus
