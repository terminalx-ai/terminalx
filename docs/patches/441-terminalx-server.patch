diff --git a/apps/api/src/services/workClaims/listVisibleClaims.ts b/apps/api/src/services/workClaims/listVisibleClaims.ts
new file mode 100644
index 0000000..10e07c2
--- /dev/null
+++ b/apps/api/src/services/workClaims/listVisibleClaims.ts
@@ -0,0 +1,202 @@
+import type { WorkClaimsListQuery } from '@/ts/Interfaces'
+import type {
+    WorkClaimProvider,
+    WorkClaimState,
+    WorkClaimsListResult
+} from '@/ts/Types'
+
+import { and, desc, eq, exists, gt, inArray, or, sql } from 'drizzle-orm'
+import { alias } from 'drizzle-orm/pg-core'
+import { db } from '@/db'
+import {
+    issueWorkClaims,
+    memberships,
+    organizationGithubInstallations,
+    organizationGithubRepositories,
+    organizations,
+    organizationWorkStatusSettings,
+    users
+} from '@/db/schema'
+import { workClaims } from '@/lib/constants'
+
+const SECOND_MS = 1000
+const { github } = workClaims
+
+/**
+ * The repository of a claim belongs to the organization in scope: a selected
+ * repository it can reach, or any repository of an account whose
+ * installation covers all of them.
+ */
+const repositoryConnected = () =>
+    or(
+        exists(
+            db
+                .select({ one: sql`1` })
+                .from(organizationGithubRepositories)
+                .where(
+                    and(
+                        eq(
+                            organizationGithubRepositories.organizationId,
+                            organizations.id
+                        ),
+                        eq(
+                            organizationGithubRepositories.state,
+                            github.repositoryAccessible
+                        ),
+                        sql`${issueWorkClaims.repository} = ${`${github.host}/`}::text || lower(${organizationGithubRepositories.fullName})`
+                    )
+                )
+        ),
+        exists(
+            db
+                .select({ one: sql`1` })
+                .from(organizationGithubInstallations)
+                .where(
+                    and(
+                        eq(
+                            organizationGithubInstallations.organizationId,
+                            organizations.id
+                        ),
+                        eq(
+                            organizationGithubInstallations.state,
+                            github.installationConnected
+                        ),
+                        eq(
+                            organizationGithubInstallations.repositorySelection,
+                            github.allRepositories
+                        ),
+                        sql`split_part(${issueWorkClaims.repository}, '/', 1) = ${github.host}::text`,
+                        sql`split_part(${issueWorkClaims.repository}, '/', 2) = lower(${organizationGithubInstallations.accountLogin})`
+                    )
+                )
+        )
+    )
+
+/**
+ * Another person's claim is shown only through an organization both belong
+ * to that is not personal, has work status on, and connected the claim's
+ * repository. Membership is read here on every request, so someone removed
+ * from the organization stops seeing its claims at once.
+ */
+const sharedWithCaller = (userId: string) => {
+    const callerMembership = alias(memberships, 'caller_membership')
+    const ownerMembership = alias(memberships, 'owner_membership')
+    return and(
+        eq(issueWorkClaims.shareWithTeam, true),
+        sql`${issueWorkClaims.repository} IS NOT NULL`,
+        exists(
+            db
+                .select({ one: sql`1` })
+                .from(callerMembership)
+                .innerJoin(
+                    ownerMembership,
+                    and(
+                        eq(
+                            ownerMembership.organizationId,
+                            callerMembership.organizationId
+                        ),
+                        eq(ownerMembership.userId, issueWorkClaims.userId)
+                    )
+                )
+                .innerJoin(
+                    organizations,
+                    and(
+                        eq(organizations.id, callerMembership.organizationId),
+                        eq(organizations.isPersonal, false)
+                    )
+                )
+                .leftJoin(
+                    organizationWorkStatusSettings,
+                    eq(
+                        organizationWorkStatusSettings.organizationId,
+                        organizations.id
+                    )
+                )
+                .where(
+                    and(
+                        eq(callerMembership.userId, userId),
+                        sql`coalesce(${organizationWorkStatusSettings.shareWorkStatus}, true)`,
+                        repositoryConnected()
+                    )
+                )
+        )
+    )
+}
+
+const listVisibleClaims = async (
+    userId: string,
+    query: WorkClaimsListQuery,
+    now: Date = new Date()
+): Promise<WorkClaimsListResult> => {
+    const nowMs = now.getTime()
+    const liveAfter = nowMs - workClaims.liveForSeconds * SECOND_MS
+    const rows = await db
+        .select({
+            userId: issueWorkClaims.userId,
+            deviceId: issueWorkClaims.deviceId,
+            deviceLabel: issueWorkClaims.deviceLabel,
+            sessionId: issueWorkClaims.sessionId,
+            scope: issueWorkClaims.scope,
+            issueProvider: issueWorkClaims.issueProvider,
+            issueId: issueWorkClaims.issueId,
+            issueIdentifier: issueWorkClaims.issueIdentifier,
+            title: issueWorkClaims.title,
+            branch: issueWorkClaims.branch,
+            state: issueWorkClaims.state,
+            cloud: issueWorkClaims.cloud,
+            since: issueWorkClaims.since,
+            lastActiveAt: issueWorkClaims.lastActiveAt,
+            refreshedAt: issueWorkClaims.refreshedAt,
+            personName: sql<string>`coalesce(nullif(btrim(${users.name}), ''), split_part(${users.email}, '@', 1))`
+        })
+        .from(issueWorkClaims)
+        .innerJoin(users, eq(users.id, issueWorkClaims.userId))
+        .where(
+            and(
+                eq(issueWorkClaims.issueProvider, query.provider),
+                inArray(issueWorkClaims.scope, query.scopes),
+                gt(issueWorkClaims.expiresAt, now),
+                gt(
+                    issueWorkClaims.lastActiveAt,
+                    new Date(nowMs - workClaims.retentionSeconds * SECOND_MS)
+                ),
+                or(eq(issueWorkClaims.userId, userId), sharedWithCaller(userId))
+            )
+        )
+        .orderBy(
+            desc(issueWorkClaims.lastActiveAt),
+            desc(issueWorkClaims.refreshedAt),
+            issueWorkClaims.id
+        )
+        .limit(workClaims.maxClaimsPerRead)
+    return {
+        now: nowMs,
+        liveForSeconds: workClaims.liveForSeconds,
+        claims: rows.map((row) => {
+            const you = row.userId === userId
+            return {
+                scope: row.scope,
+                issue: {
+                    provider: row.issueProvider as WorkClaimProvider,
+                    id: row.issueId,
+                    identifier: row.issueIdentifier
+                },
+                person: { name: row.personName, you },
+                device: you
+                    ? { id: row.deviceId, label: row.deviceLabel }
+                    : null,
+                sessionId: you ? row.sessionId : null,
+                title: row.title,
+                branch: row.branch,
+                state: row.state as WorkClaimState,
+                cloud: row.cloud,
+                live: row.refreshedAt.getTime() > liveAfter,
+                since: row.since.getTime(),
+                lastActiveAt: row.lastActiveAt.getTime(),
+                refreshedAt: row.refreshedAt.getTime()
+            }
+        })
+    }
+}
+
+export default listVisibleClaims
\ No newline at end of file
diff --git a/apps/api/src/services/workClaims/replaceDeviceClaims.ts b/apps/api/src/services/workClaims/replaceDeviceClaims.ts
new file mode 100644
index 0000000..26107dd
--- /dev/null
+++ b/apps/api/src/services/workClaims/replaceDeviceClaims.ts
@@ -0,0 +1,122 @@
+import type { WorkClaimsReplaceInput } from '@/ts/Interfaces'
+import type { WorkClaimsReplaceResult } from '@/ts/Types'
+
+import { randomUUID } from 'node:crypto'
+import { and, eq, lte, notInArray, sql } from 'drizzle-orm'
+import { db } from '@/db'
+import { issueWorkClaims } from '@/db/schema'
+import { workClaims } from '@/lib/constants'
+import deviceLock from '@/services/workClaims/deviceLock'
+
+const SECOND_MS = 1000
+
+const excluded = (column: string) => sql.raw(`excluded."${column}"`)
+
+/**
+ * Replaces one device's claim set in one transaction, serialized per device
+ * so two publishes from it cannot leave the union of both. A session that is
+ * not in the set is withdrawn. `since` survives a refresh of the same issue
+ * and restarts when the session moves to another one.
+ */
+const replaceDeviceClaims = async (
+    userId: string,
+    deviceId: string,
+    input: WorkClaimsReplaceInput,
+    now: Date = new Date()
+): Promise<WorkClaimsReplaceResult> => {
+    const expiresAt = new Date(
+        now.getTime() + workClaims.retentionSeconds * SECOND_MS
+    )
+    const sessionIds = input.claims.map((claim) => claim.sessionId)
+    await db.transaction(async (tx) => {
+        await deviceLock(tx, userId, deviceId)
+        await tx
+            .delete(issueWorkClaims)
+            .where(
+                and(
+                    eq(issueWorkClaims.userId, userId),
+                    eq(issueWorkClaims.deviceId, deviceId),
+                    sessionIds.length
+                        ? notInArray(issueWorkClaims.sessionId, sessionIds)
+                        : undefined
+                )
+            )
+        if (input.claims.length)
+            await tx
+                .insert(issueWorkClaims)
+                .values(
+                    input.claims.map((claim) => ({
+                        id: randomUUID(),
+                        userId,
+                        deviceId,
+                        deviceLabel: input.deviceLabel,
+                        sessionId: claim.sessionId,
+                        scope: claim.scope,
+                        repository: claim.repository,
+                        issueProvider: claim.issue.provider,
+                        issueId: claim.issue.id,
+                        issueIdentifier: claim.issue.identifier,
+                        title: claim.title,
+                        branch: claim.branch,
+                        state: claim.state,
+                        cloud: claim.cloud,
+                        shareWithTeam: claim.shareWithTeam,
+                        since: now,
+                        lastActiveAt: new Date(
+                            now.getTime() - claim.idleSeconds * SECOND_MS
+                        ),
+                        refreshedAt: now,
+                        expiresAt,
+                        createdAt: now,
+                        updatedAt: now
+                    }))
+                )
+                .onConflictDoUpdate({
+                    target: [
+                        issueWorkClaims.userId,
+                        issueWorkClaims.deviceId,
+                        issueWorkClaims.sessionId
+                    ],
+                    set: {
+                        deviceLabel: excluded('device_label'),
+                        scope: excluded('scope'),
+                        repository: excluded('repository'),
+                        issueProvider: excluded('issue_provider'),
+                        issueId: excluded('issue_id'),
+                        issueIdentifier: excluded('issue_identifier'),
+                        title: excluded('title'),
+                        branch: excluded('branch'),
+                        state: excluded('state'),
+                        cloud: excluded('cloud'),
+                        shareWithTeam: excluded('share_with_team'),
+                        since: sql`CASE WHEN ${issueWorkClaims.issueProvider} = ${excluded('issue_provider')} AND ${issueWorkClaims.scope} = ${excluded('scope')} AND ${issueWorkClaims.issueIdentifier} = ${excluded('issue_identifier')} THEN ${issueWorkClaims.since} ELSE ${excluded('since')} END`,
+                        lastActiveAt: excluded('last_active_at'),
+                        refreshedAt: excluded('refreshed_at'),
+                        expiresAt: excluded('expires_at'),
+                        updatedAt: excluded('updated_at')
+                    }
+                })
+        await tx
+            .delete(issueWorkClaims)
+            .where(
+                and(
+                    eq(issueWorkClaims.userId, userId),
+                    lte(issueWorkClaims.expiresAt, now)
+                )
+            )
+    })
+    try {
+        await db
+            .delete(issueWorkClaims)
+            .where(lte(issueWorkClaims.expiresAt, now))
+    } catch (error) {
+        console.error('replaceDeviceClaims', error)
+    }
+    return {
+        claims: input.claims.length,
+        refreshAfterSeconds: workClaims.refreshAfterSeconds,
+        liveForSeconds: workClaims.liveForSeconds
+    }
+}
+
+export default replaceDeviceClaims
\ No newline at end of file
