diff --git a/mobile/src/measure/marks.ts b/mobile/src/measure/marks.ts
new file mode 100644
index 00000000..35b09168
--- /dev/null
+++ b/mobile/src/measure/marks.ts
@@ -0,0 +1,52 @@
+// Throwaway measurement instrumentation for issue #989. Not for shipping.
+// Each mark goes to a JSONL file in the app's Documents folder, pulled with
+// `xcrun devicectl device copy from --domain-type appDataContainer`.
+import { File, Directory, Paths } from "expo-file-system";
+import { Settings } from "react-native";
+
+const launchedAt = Date.now();
+const runId = String(Settings.get("TXRunId") ?? `run-${launchedAt}`);
+const rawInterval = Settings.get("TXKeepAliveMs");
+/** Keep-alive interval for this launch, from the launch argument `-TXKeepAliveMs <ms>`. 0 turns it off. Default is today's 30 s. */
+export const KEEP_ALIVE_MS = rawInterval === undefined || rawInterval === null || rawInterval === "" ? 30_000 : Number(rawInterval);
+
+/** Launch argument `-TXNoDirect 1`: skip the LAN paths so the relay path is measured on the home Wi-Fi. */
+export const NO_DIRECT = String(Settings.get("TXNoDirect") ?? "") === "1";
+
+const lines: string[] = [];
+let dirty = false;
+const directory = new Directory(Paths.document, "measure");
+const file = new File(directory, `${runId}.jsonl`);
+
+export function mark(name: string, data?: Record<string, unknown>): void {
+  lines.push(JSON.stringify({ name, wall: Date.now(), mono: performance.now(), ...data }));
+  dirty = true;
+}
+
+function flush(): void {
+  if (!dirty) return;
+  dirty = false;
+  try {
+    if (!directory.exists) directory.create({ intermediates: true, idempotent: true });
+    file.writeSync(lines.join("\n") + "\n");
+  } catch {
+    dirty = true;
+  }
+}
+setInterval(flush, 2_000);
+
+// Native start points, written into NSUserDefaults by the patched AppDelegate before React Native starts.
+let startup: Record<string, unknown> = {};
+try {
+  const t = (performance as unknown as { rnStartupTiming: { startTime: number; initializeRuntimeStart: number; executeJavaScriptBundleEntryPointStart: number; endTime: number } }).rnStartupTiming;
+  startup = { rnStartTime: t.startTime, rnInitializeRuntimeStart: t.initializeRuntimeStart, rnExecuteBundleStart: t.executeJavaScriptBundleEntryPointStart, rnEndTime: t.endTime };
+} catch { /* not available */ }
+mark("js.module-eval", {
+  runId,
+  keepAliveMs: KEEP_ALIVE_MS,
+  noDirect: NO_DIRECT,
+  processStartWall: Settings.get("TXProcessStartMs") ?? null,
+  didFinishLaunchingWall: Settings.get("TXDidFinishLaunchingMs") ?? null,
+  timeOrigin: performance.timeOrigin,
+  ...startup,
+});
