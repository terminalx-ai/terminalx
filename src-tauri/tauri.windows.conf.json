{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TerminalX",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "publisher": "TerminalX",
    "shortDescription": "TerminalX — a desktop workbench for coding agents",
    "homepage": "https://github.com/terminalx-ai/terminalx",
    "license": "MIT",
    "externalBin": [
      "binaries/agent-browser"
    ],
    "resources": {
      "../native/computer-use-macos/.build/release/TerminalX Computer Use Helper.app": null,
      "../native/computer-use-macos/.build/release-dev/TerminalX Computer Use Helper.app": null,
      "../native/computer-use-windows/runtime.ps1": "computer-use-windows/runtime.ps1",
      "../resources/windows/terminalx.cmd": "terminalx.cmd",
      "../resources/windows/tnx.cmd": "tnx.cmd",
      "target/local-runtime/": "local-runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/terminalx-ai/terminalx/releases/latest/download/latest-windows.json"
      ]
    }
  }
}
